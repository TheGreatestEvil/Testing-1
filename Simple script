--------------------------------------------------
-- SPEED SETTINGS
--------------------------------------------------

local MinSpeed = 1
local MaxSpeed = 1000
local CurrentSpeed = 16

local draggingSpeed = false

local function setSpeedFromPosition(x)

    local sliderStart =
        SpeedSlider.AbsolutePosition.X

    local sliderWidth =
        SpeedSlider.AbsoluteSize.X

    local percent =
        math.clamp(
            (x - sliderStart) / sliderWidth,
            0,
            1
        )

    CurrentSpeed =
        math.floor(
            MinSpeed +
            (MaxSpeed - MinSpeed) * percent
        )

    SpeedLabel.Text =
        "Speed: " .. CurrentSpeed

    SpeedFill.Size =
        UDim2.new(percent, 0, 1, 0)

    SpeedKnob.Position =
        UDim2.new(percent, 0, 0.5, 0)

    local character =
        LocalPlayer.Character

    local humanoid =
        character
        and character:FindFirstChildOfClass(
            "Humanoid"
        )

    if humanoid then
        humanoid.WalkSpeed = CurrentSpeed
    end
end

--------------------------------------------------
-- MOUSE + TOUCH
--------------------------------------------------

SpeedKnob.InputBegan:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or input.UserInputType ==
        Enum.UserInputType.Touch then

        draggingSpeed = true

    end
end)

SpeedSlider.InputBegan:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or input.UserInputType ==
        Enum.UserInputType.Touch then

        draggingSpeed = true

        setSpeedFromPosition(input.Position.X)

    end
end)

UserInputService.InputChanged:Connect(function(input)

    if not draggingSpeed then
        return
    end

    if input.UserInputType ==
        Enum.UserInputType.MouseMovement
        or input.UserInputType ==
        Enum.UserInputType.Touch then

        setSpeedFromPosition(
            input.Position.X
        )

    end
end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or input.UserInputType ==
        Enum.UserInputType.Touch then

        draggingSpeed = false

    end
end)

--------------------------------------------------
-- APPLY SPEED AFTER RESPAWN
--------------------------------------------------

LocalPlayer.CharacterAdded:Connect(function(character)

    local humanoid =
        character:WaitForChild("Humanoid")

    humanoid.WalkSpeed = CurrentSpeed

end)

--------------------------------------------------
-- START AT 16 SPEED
--------------------------------------------------

setSpeedFromPosition(
    SpeedSlider.AbsolutePosition.X +
    SpeedSlider.AbsoluteSize.X *
    ((CurrentSpeed - MinSpeed) /
    (MaxSpeed - MinSpeed))
)
